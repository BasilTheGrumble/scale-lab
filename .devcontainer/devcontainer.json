{
  "name": "Scale Lab",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "devcontainer",
  "runServices": [
    "devcontainer",
    "postgres",
    "kafka",
    "rustfs"
  ],
  "workspaceFolder": "/workspaces/scale-lab",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "uv sync --dev --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  }
}