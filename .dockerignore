# Build context only: runtime bind mounts are unaffected.
# Keep source, tests, SQL, pyproject.toml, uv.lock, and build configuration.

# Git metadata and local editor settings
**/.git
**/.idea
**/.vscode
**/.DS_Store
**/tempCodeRunnerFile.py

# Local credentials and environment settings (keep the example template)
**/.env
**/.env.*
!**/.env.example
**/.envrc
**/.pypirc
**/.netrc
**/.aws
**/.ssh
**/secrets
**/*.key
**/*.pem
**/*.p12
**/*.pfx

# Local Python environments and compiled bytecode
**/.venv
**/venv
**/env
**/ENV
**/env.bak
**/venv.bak
**/__pypackages__
**/__pycache__
**/*.py[cod]

# Tool caches and test reports
**/.cache
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.hypothesis
**/.tox
**/.nox
**/.pyre
**/.pytype
**/.ipynb_checkpoints
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov

# Generated packages, logs, and local experiment outputs
/build
/dist
**/*.egg-info
**/*.egg
**/*.log
/data
/artifacts

